# --- generated analysis output ----------------------------------------------
paper/generated_macros.tex
paper/*.log
analysis/output/
figures/output/

# --- measurements -----------------------------------------------------------
# data/runs/ holds real experiment output. It is ignored by default because runs
# are large and machine-specific; commit the specific run directory backing a
# submission explicitly with `git add -f data/runs/<timestamp>-.../`.
data/runs/

# data/example/ is generated by `make example-data` and is reproducible from the
# seed, so it does not need to be committed either. Nothing in it is a
# measurement.
data/example/

# --- environments -----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
# package-lock.json is deliberately NOT ignored: it pins the exact dependency
# tree a run used, which is the whole point of a reproducibility artifact.
# Do the same for Python with `pip freeze > requirements.lock.txt` and keep that
# file alongside the run it describes.

# --- secrets ----------------------------------------------------------------
# Token files handed to k6 (PSAO_TOKEN_FILE / PSAO_TOKEN_POOL) are bearer
# credentials, even for a test issuer.
*.token
tokens/
*.pem
!controller/*.example.pem

# --- editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# Scratch state written by set_mesh_posture.sh: an absolute path to the last
# backup on THIS machine. Meaningless elsewhere and leaks the local layout.
.last_posture_backup

# --- LaTeX build artifacts --------------------------------------------------
# The .tex, .bib, the generated macros and the compiled .pdf are committed;
# everything below is regenerated by `tectonic -X compile`.
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.out
paper/*.toc
paper/*.synctex.gz

# --- prevalence survey ------------------------------------------------------
# Fetched third-party source files. The analysis output (callsites.csv,
# counterexamples.json, hits.json) IS committed; the corpus itself is not, to
# avoid redistributing other people's code. survey/collect.py regenerates it.
survey/data/files/
survey/data/counterexamples/
